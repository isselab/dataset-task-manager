{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isselab/agentic-dataset-template/schema/evolution-step.schema.json",
  "title": "Feature-evolution dataset step",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sequence",
    "before_version",
    "after_version",
    "prompts",
    "scenario_types",
    "expected_changes",
    "ground_truth"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^step-[0-9]{3,}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "before_version": { "type": "string", "pattern": "^v[0-9]{3,}$" },
    "after_version": { "type": "string", "pattern": "^v[0-9]{3,}$" },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "path"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scenario_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "add",
          "modify",
          "remove",
          "merge",
          "split",
          "rename",
          "relocate",
          "interact"
        ]
      }
    },
    "expected_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "features_before",
          "features_after",
          "description"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "operation": {
            "enum": [
              "add",
              "modify",
              "remove",
              "merge",
              "split",
              "rename",
              "relocate",
              "interact"
            ]
          },
          "features_before": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "features_after": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ground_truth": { "type": "string", "minLength": 1 }
  }
}
